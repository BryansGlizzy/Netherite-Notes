{
  "name": "netherite-notes",
  "version": "1.2.0",
  "description": "Multi-user Obsidian clone with SQLite backend",
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "dev": "NODE_ENV=development node server.js",
    "build": "vite build && npm run build-sw",
    "build-sw": "node scripts/build-sw.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "health": "node scripts/smoke-test.js",
    "smoke": "node scripts/smoke-test.js --full",
    "db:backup": "node scripts/db-backup.js",
    "admin:create": "node scripts/admin-create.js",
    "lint": "eslint .",
    "doctor": "node scripts/doctor.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "d3": "^7.8.5",
    "dexie": "^4.4.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.292.0",
    "nodemailer": "^10.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "sqlite3": "^6.0.1",
    "vite-express": "^0.22.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.2.2",
    "vite": "^7.3.7",
    "workbox-build": "^7.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
