# Copy to .env and fill in. server.js loads ./.env (override the path with ENV_FILE).
# All variables except the secrets are optional; defaults are shown.

# --- Required: at least one of these. Use two different 32+ char random values:  openssl rand -hex 32
# JWT_SECRET signs session tokens; TOKEN_SECRET keys the HMAC-SHA256 hash of API tokens.
# Changing TOKEN_SECRET invalidates every existing API token.
JWT_SECRET=
TOKEN_SECRET=

# Optional dedicated key for encrypting stored AI API keys (32 bytes, base64 or hex):  openssl rand -base64 32
# If unset, a key is derived from JWT_SECRET. Changing either one later makes saved AI keys unreadable (users re-enter them).
DATA_ENCRYPTION_KEY=

# --- Server
# NODE_ENV: anything other than "development" runs in production mode (the default).
# Development mode starts the Vite dev server, which serves project files — never use it on a public host.
NODE_ENV=production
PORT=20100
# Bind address. Default 0.0.0.0 in production, 127.0.0.1 in development.
HOST=
# Number of reverse proxies in front of the app (1 for nginx/Caddy on the same host). Needed so rate limits
# see real client IPs. Leave unset/false when clients connect directly.
TRUST_PROXY=
# Comma-separated browser origins allowed to call the API cross-origin. Empty = same-origin only.
CORS_ORIGINS=
# Database file (default ./obsidian.db) and where automatic pre-migration backups go (default: ./backups next to the DB)
DB_PATH=./obsidian.db
BACKUP_DIR=
# Extra hostnames the development server (npm run dev) answers to; irrelevant in production
ALLOWED_HOSTS=

# --- Email (password reset)
# STARTTLS is required by default; set SMTP_REQUIRE_TLS=false only for a trusted local relay.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
# From address on outgoing mail; defaults to SMTP_USER when that is an email address
SMTP_FROM=
SMTP_REQUIRE_TLS=true

# Comma-separated emails that get admin-panel access. An address must be verified (by email link, or created with
# the CLI) before it counts, and it cannot be claimed through sign-up:
#   npm run admin:create -- --email you@example.com --username you
ADMIN_EMAILS=

# Who may create accounts: open (default) | invite (admins hand out single-use codes) | closed
REGISTRATION=open

# Public base URL, used in password-reset links
APP_URL=http://localhost:20100

# --- Limits (defaults shown)
# RATE_LIMIT_LOGIN_MAX=10        failed logins per 15 min, per IP and per username
# RATE_LIMIT_REGISTER_MAX=10     sign-ups per hour per IP
# RATE_LIMIT_FORGOT_MAX=3        reset emails per hour per IP and per address
# RATE_LIMIT_API_MAX=3000        all /api requests per minute per IP
# RATE_LIMIT_API_FAIL_MAX=120    failed (>=400) /api requests per minute per IP
# RATE_LIMIT_V1_TOKEN_MAX=120    requests per minute per API token
# RATE_LIMIT_V1_FAIL_MAX=60      failed v1 requests per minute per IP
# MAX_TOKENS_PER_VAULT=50
# IMPORT_MAX_NOTES=10000
# MAX_NOTES_PER_VAULT=50000
# AUDIT_RETENTION_DAYS=180
